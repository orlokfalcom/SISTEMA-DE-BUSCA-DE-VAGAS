# ==============================================================================
# VagaPulse AI — Exemplo de Configuração de Ambiente (NUNCA commite .env real)
# ==============================================================================

# Flask / Sessão & Segurança
FLASK_SECRET_KEY=substitua-por-chave-aleatoria-de-64-caracteres-hex
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# Segurança da API de Defesa Cibernética (Opcional em loopback; obrigatório em produção)
SECURITY_API_TOKEN=substitua-por-token-administrativo-forte

# LinkedIn OAuth 2.0 (Obtido no LinkedIn Developer Portal)
LINKEDIN_CLIENT_ID=seu_client_id_ficticio_aqui
LINKEDIN_CLIENT_SECRET=seu_client_secret_ficticio_aqui
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/linkedin/oauth/callback
LINKEDIN_ALLOWED_REDIRECT_URIS=http://localhost:5000/api/linkedin/oauth/callback,https://seu-dominio.com/api/linkedin/oauth/callback
LINKEDIN_SCOPES=openid profile email

# Criptografia de Tokens em Repouso (separada do banco SQLite)
LINKEDIN_TOKEN_ENC_KEY=substitua-por-segredo-kms-ou-chave-mestra-32-bytes
